PORT=8000
DATABASE_URL=postgres://hellojess:hellojess@localhost:5432/hellojess
CORS_ORIGIN=*
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Creates/updates tables automatically. Set to false once you manage the schema with migrations.
DB_SYNCHRONIZE=true

# Email for the verification codes (sign-up and login). Leave SMTP_HOST empty in development:
# the code is then printed in the backend log instead of being emailed.
# With Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address, SMTP_PASS=an "app password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HelloJess <no-reply@hellojess.local>
# The phone app stays logged in this many days, then asks for the password and a new code.
MOBILE_TOKEN_EXPIRE_DAYS=30
